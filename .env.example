# Environment identity: development, staging, or production.
GREENCHOICE_ENV=development
EXPECTED_SUPABASE_PROJECT_REF=

# Canonical application origins. Production values must use HTTPS.
APP_URL=http://127.0.0.1:3001
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3001
ALLOWED_ORIGINS=http://127.0.0.1:3001,http://localhost:3001

# Supabase. Never expose service-role or secret keys with NEXT_PUBLIC_ names.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
STORAGE_BUCKET_PRODUCTS=product-images

# Application security secrets. Use independent random values of at least 32 bytes.
CSRF_SECRET=
SESSION_SIGNING_SECRET=
STAFF_SESSION_SIGNING_SECRET=
GREENCHOICE_PASSWORD_FINGERPRINT_SECRET=
RATE_LIMIT_KEY_SECRET=

# Distributed rate limiting. Required in production.
RATE_LIMIT_REDIS_REST_URL=
RATE_LIMIT_REDIS_REST_TOKEN=

# Optional Upstash Redis display cache. Supabase remains the source of truth.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional server-side diagnostics. Leave blank to disable exception export.
GREENCHOICE_LOG_LEVEL=info
GREENCHOICE_SUPPORT_EMAIL=
GREENCHOICE_SUPPORT_PHONE=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
ERROR_REPORTING_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
SENTRY_TRACES_SAMPLE_RATE=0.2
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.2
NEXT_PUBLIC_SENTRY_REPLAY_SAMPLE_RATE=0.02
NEXT_PUBLIC_SENTRY_REPLAY_ERROR_SAMPLE_RATE=1
READINESS_DIAGNOSTIC_SECRET=

# Explicit one-time/local scripts. Never place real values in this file.
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=
ALLOW_ADMIN_BOOTSTRAP=false
ALLOW_DESTRUCTIVE_LOCAL_SEED=false
DEV_MANAGER_EMAIL=
DEV_MANAGER_PASSWORD=
DEV_RECEPTIONIST_EMAIL=
DEV_RECEPTIONIST_PASSWORD=
E2E_MANAGER_EMAIL=
E2E_RECEPTIONIST_EMAIL=
E2E_STAFF_PASSWORD=
