GREENCHOICE_ENV=staging
EXPECTED_SUPABASE_PROJECT_REF=your-staging-project-ref
PRODUCTION_SUPABASE_PROJECT_REF=your-production-project-ref
GREENCHOICE_CUSTOMER_EXPERIENCE_ENABLED=true
GREENCHOICE_LOCAL_PENDING_ORDERS=true
# npm run dev normalizes these URLs to http://127.0.0.1:3001 locally.
# build:staging and dev:staging require your HTTPS staging origin.
APP_URL=https://your-staging-app.example
NEXT_PUBLIC_APP_URL=https://your-staging-app.example
ALLOWED_ORIGINS=https://your-staging-app.example
NEXT_PUBLIC_SUPABASE_URL=https://your-staging-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
CSRF_SECRET=replace-with-at-least-32-random-characters
SESSION_SIGNING_SECRET=replace-with-at-least-32-random-characters
STAFF_SESSION_SIGNING_SECRET=replace-with-at-least-32-random-characters
GREENCHOICE_PASSWORD_FINGERPRINT_SECRET=replace-with-at-least-32-random-characters
RATE_LIMIT_KEY_SECRET=replace-with-at-least-32-random-characters
READINESS_DIAGNOSTIC_SECRET=replace-with-at-least-32-random-characters
RATE_LIMIT_REDIS_REST_URL=
RATE_LIMIT_REDIS_REST_TOKEN=
# Optional cache timeout, clamped to 100-2000 ms. Default: 750 ms.
GREENCHOICE_CACHE_REDIS_TIMEOUT_MS=750
ALLOW_ADMIN_BOOTSTRAP=false
ALLOW_DESTRUCTIVE_LOCAL_SEED=false
# Store QR registration: no simulated production verification.
QR_VERIFICATION_URL=
QR_VERIFICATION_API_KEY=
QR_VERIFICATION_APPROVED=false
QR_REGISTRATION_LEGAL_APPROVED=
CUSTOMER_ID_HMAC_SECRET=

# Paystack hosted checkout (test mode only). Configure public HTTPS URLs for staging.
PAYSTACK_SECRET_KEY=
PAYSTACK_MODE=test
PAYSTACK_BILLING_ENABLED=true
PAYSTACK_WEBHOOK_URL=
PAYSTACK_CALLBACK_URL=
