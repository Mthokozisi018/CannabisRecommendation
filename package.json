{
  "name": "greenchoice-workstation",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "scripts": {
    "dev": "npm run verify:local-env && node scripts/run-with-local-env.mjs node_modules/next/dist/bin/next dev --hostname 0.0.0.0 --port 3001",
    "build": "next build",
    "build:local": "npm run verify:local-env && node scripts/run-with-local-env.mjs node_modules/next/dist/bin/next build",
    "start": "next start --hostname 0.0.0.0 --port 3001",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "vitest run",
    "test:security": "vitest run tests/security",
    "test:e2e": "npm run verify:local-env && node scripts/run-with-local-env.mjs node_modules/@playwright/test/cli.js test",
    "test:qr-ui": "playwright test --config tests/local/qr-ui.playwright.config.ts",
    "cleanup:registration-documents": "node scripts/cleanup-registration-documents.mjs",
    "verify:local-env": "node scripts/verify-local-environment.mjs",
    "validate:migrations": "node scripts/validate-migrations.mjs",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "check": "npm run lint && npm run typecheck && npm run validate:migrations && npm run scan:secrets && npm run test && npm run audit:production",
    "seed:preview": "tsx scripts/seed-preview.ts",
    "seed:admin": "node scripts/seed-admin-user.mjs",
    "verify:staging-env": "node scripts/verify-staging-environment.mjs",
    "verify:paystack-staging-runtime": "npm run verify:staging-env && node scripts/run-with-staging-env.mjs scripts/verify-paystack-staging-runtime.mjs",
    "dev:staging": "npm run verify:staging-env && node scripts/run-with-staging-env.mjs node_modules/next/dist/bin/next dev --hostname 0.0.0.0 --port 3001",
    "build:staging": "npm run verify:staging-env && node scripts/run-with-staging-env.mjs node_modules/next/dist/bin/next build",
    "test:e2e:staging": "npm run verify:staging-env && node scripts/run-with-staging-env.mjs node_modules/@playwright/test/cli.js test",
    "test:fa:coverage": "vitest run --config tests/audit/fa-coverage.config.mts",
    "test:fa:ui": "playwright test --config tests/local/franchise-overview.playwright.config.ts"
  },
  "dependencies": {
    "@elastic/elasticsearch": "^9.5.1",
    "@sentry/nextjs": "10.75.2",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.77.0",
    "@upstash/redis": "^1.38.0",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "lucide-react": "^0.468.0",
    "next": "16.4.3",
    "qrcode": "1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "sharp": "0.35.5",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "^1.55.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "^22.16.0",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitest/coverage-v8": "5.0.5",
    "autoprefixer": "^10.4.21",
    "axe-core": "4.14.0",
    "eslint": "^9.31.0",
    "eslint-config-next": "16.4.3",
    "jsdom": "29.1.1",
    "postcss": "8.5.24",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "postcss": "8.5.24",
    "sharp": "0.35.5",
    "undici": "7.30.1",
    "browserslist": "4.28.8",
    "postcss-selector-parser": "7.1.6"
  }
}
